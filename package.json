{
  "name": "v_8-deepseaplat",
  "version": "8.0.0",
  "description": "Mr Pryer Math Version 8 Deep Sea",
  "main": "main.js",
  "author": "Mr Pryer Maths",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis",
    "publish:win": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "au.mrpryermaths.v8deepsea",
    "productName": "Mr Pryer Math Version 8 Deep Sea",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "anchor.ico",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "anchor.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mr Pryer Math Version 8 Deep Sea",
      "artifactName": "V_8-Deepseaplat.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "damonmclaren06-dev",
        "repo": "Mp-math-online-cosmos",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
